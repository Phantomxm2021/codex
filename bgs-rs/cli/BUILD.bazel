load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "bgs_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "bgs_e2e_benchmark")
load("//bazel/rules:runtime_package.bzl", "release_binary")

bgs_rust_crate(
    name = "cli",
    binaries_with_build_commit = ["bgs"],
    crate_name = "bgs_cli",
    extra_binaries = [
        "//bgs-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

release_binary(
    binary = ":bgs",
)

multiplatform_binaries(
    name = "bgs",
)

bgs_e2e_benchmark(
    name = "bgs-help",
    binaries = [":bgs"],
)
