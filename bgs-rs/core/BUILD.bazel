load("//:defs.bzl", "bgs_rust_crate")

bgs_rust_crate(
    name = "core",
    compile_data = glob(["assets/**"]),
    crate_name = "bgs_core",
    crate_srcs = glob(["src/**/*.rs"]) + [
        "//bgs-rs/ext/guardian-v2:src/sync_reviewer/reviewer_config.rs",
    ],
    extra_binaries = [
        "//bgs-rs/bwrap:bwrap",
        "//bgs-rs/code-mode-host:bgs-code-mode-host",
        "//bgs-rs/linux-sandbox:bgs-linux-sandbox",
        "//bgs-rs/rmcp-client:test_stdio_server",
        "//bgs-rs/rmcp-client:test_streamable_http_server",
        "//bgs-rs/cli:bgs",
        "//bgs-rs/windows-sandbox-rs:bgs-command-runner",
        "//bgs-rs/windows-sandbox-rs:bgs-windows-managed-deny-probe",
        "//bgs-rs/windows-sandbox-rs:bgs-windows-sandbox-setup",
    ],
    integration_compile_data_extra = glob(["assets/**"]) + [
        "//bgs-rs/prompts:templates/permissions/approval_policy/on_request_rule_request_permission.md",
    ],
    integration_test_timeout = "long",
    run_tests_with_wine_exec = True,
    rustc_env = {
        # Keep manifest-root path lookups inside the Bazel execroot for code
        # that relies on env!("CARGO_MANIFEST_DIR").
        "CARGO_MANIFEST_DIR": "bgs-rs/core",
    },
    test_data_extra = [
        "config.schema.json",
    ] + glob(["src/**/snapshots/**"]) + [
    ],
    test_shard_counts = {
        "core-all-test": 16,
        "core-unit-tests": 8,
    },
    test_tags = ["no-sandbox"],
    test_threads = select({
        "@platforms//os:macos": 1,
        "//conditions:default": 0,
    }),
    unit_test_srcs = glob([
        "src/**/*_test.rs",
        "src/**/*_tests.rs",
        "src/**/tests.rs",
        "src/**/tests/**/*.rs",
    ]) + [
        "src/apps/render.rs",
        "src/config/schema.rs",
        "src/context/world_state/test_support.rs",
        "src/guardian/test_host.rs",
        "src/plugins/test_support.rs",
    ],
    unit_test_timeout = "long",
)
