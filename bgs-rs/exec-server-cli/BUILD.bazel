load("//:defs.bzl", "bgs_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:runtime_package.bzl", "release_binary")

bgs_rust_crate(
    name = "exec-server-cli",
    binaries_with_build_commit = ["bgs-exec-server"],
    crate_name = "bgs_exec_server_cli",
    extra_binaries = ["//bgs-rs/bwrap:bwrap"],
    test_data_extra = glob(["src/**/snapshots/**"]),
    # The standalone integration test launches native OS sandboxes itself.
    test_tags = ["no-sandbox"],
)

release_binary(binary = ":bgs-exec-server")

multiplatform_binaries(name = "bgs-exec-server")
